# ── White-label site configuration (see lib/site-config.ts) ──────────────
# Copy to .env.local and set real values. Changing these updates all
# metadata, titles, OpenGraph cards, manifest, and sitemap on rebuild —
# no code changes needed. NEVER commit real values (see .gitignore).

# Canonical public origin (no trailing slash). Used by metadataBase,
# canonical URLs, sitemap locs, OG urls, and JSON-LD ids.
FRONTEND_URL=http://localhost:3000

# Primary brand — students search for this name; anchors every page title.
NEXT_PUBLIC_TEACHER_NAME=الأستاذ عبد الهادي موسى

# Short subject label (also manifest short_name, ~12 char limit).
NEXT_PUBLIC_SUBJECT_NAME=الكيمياء

# Default title + meta description + social-card subtitle.
NEXT_PUBLIC_SITE_TAGLINE=تعلم الكيمياء بأسهل الطرق مع الأستاذ عبد الهادي موسى

# Internal backend origin for server-side fetches (sitemap course URLs).
# The FE server calls this at request time — prefer loopback over LAN/DNS.
BACKEND_INTERNAL_URL=http://127.0.0.1:3005

# Public backend origin for browser calls (existing convention).
NEXT_PUBLIC_API_URL=http://localhost:3005

# PostHog analytics (student pages only; /admin excluded). Public values - safe to commit placeholders, never real keys.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

